# Copy to .env. The app runs in local demo mode when no LLM API key is set.
# LLM_PROVIDER accepts auto, mistral, openai, or local. Auto prefers Mistral when
# MISTRAL_API_KEY is present, then OpenAI, then local fallback.
LLM_PROVIDER=auto
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
MISTRAL_REASONING_EFFORT=none
MISTRAL_TEMPERATURE=0.2

# Optional OpenAI fallback/provider. OpenAI is still used for embeddings when
# EMBEDDING_PROVIDER=auto and OPENAI_API_KEY is present.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=auto

DATABASE_URL=sqlite:///./data/legal_assistant.sqlite3
DATA_DIR=./data
APP_API_KEY=
REQUIRE_IDENTITY_HEADERS=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_MB=20
TOP_K=6
CHUNK_SIZE=500
CHUNK_OVERLAP=100
